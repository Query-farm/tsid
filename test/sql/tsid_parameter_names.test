# name: test/sql/tsid_parameter_names.test
# description: duckdb_functions() reports the real parameter names, and calls stay positional
# group: [sql]

require tsid

query TT
SELECT function_name, parameters FROM duckdb_functions()
WHERE function_name IN ('tsid', 'tsid_to_timestamp')
ORDER BY function_name;
----
tsid	[]
tsid_to_timestamp	[tsid]

query I
SELECT tsid_to_timestamp(tsid()) IS NOT NULL;
----
true
